# Serana Closet: production .env. Copy to the server as .env and fill every <…>.
# Never commit the filled file. Check it with: php artisan serana:preflight

APP_NAME="Serana Closet"
APP_ENV=production
# Keep the existing key; generate one only on a brand-new install.
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain>
APP_DISPLAY_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
# Redis when available (see docs/audit/SCALE-READINESS-2026-10-16.md).
CACHE_STORE=database

FILESYSTEM_DISK=local
# Or s3 for both, with the AWS_* block below.
FILESYSTEM_DISK_PUBLIC=public

# Transactional email on the brand domain, with SPF, DKIM and DMARC published.
MAIL_MAILER=smtp
MAIL_HOST=<provider smtp host>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_FROM_ADDRESS="orders@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"
STORE_NOTIFICATION_EMAIL=<owner inbox>

WHATSAPP_NUMBER=<2547XXXXXXXX>
DROPS_ENABLED=false

# M-Pesa (live Daraja app). Leave the keys blank to launch WhatsApp-only.
MPESA_ENV=production
MPESA_CONSUMER_KEY=<live key>
MPESA_CONSUMER_SECRET=<live secret>
MPESA_SHORTCODE=<your till or paybill>
MPESA_PASSKEY=<live passkey>
# php -r "echo bin2hex(random_bytes(24));"
MPESA_CALLBACK_TOKEN=<48 hex characters>
MPESA_CALLBACK_URL="${APP_URL}/payments/mpesa/callback/${MPESA_CALLBACK_TOKEN}"
MPESA_ALLOWED_IPS=

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=true
