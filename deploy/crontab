# Serana Closet scheduler. Install with `crontab -e` as the web user (e.g. www-data);
# replace /var/www/serana with the app path. Every minute it expires abandoned
# checkouts, releases their stock, confirms M-Pesa payments whose callback was
# missed, and records the heartbeat that `php artisan serana:preflight` checks.
* * * * * cd /var/www/serana && php artisan schedule:run >> /dev/null 2>&1

# Cron-only hosts (no supervisor): also drain the email queue every minute.
# * * * * * cd /var/www/serana && php artisan queue:work --stop-when-empty --tries=3 --max-time=55 >> /dev/null 2>&1

# Nightly backup at 02:30 (database + uploads, checked, copied off-server, pruned).
# Set BACKUP_REMOTE to an rclone destination first; see deploy/RESTORE.md.
30 2 * * * cd /var/www/serana && BACKUP_REMOTE=r2:serana-backups ./deploy/backup.sh >> storage/logs/backup.log 2>&1
