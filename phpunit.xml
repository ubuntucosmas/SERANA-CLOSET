<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- SQLite by default. Real env vars win (no force="true"): run on MariaDB with
             DB_CONNECTION=mariadb DB_DATABASE=testing (name must contain "test", see tests/TestCase.php). -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MPESA_QUERY_SPACING_SECONDS" value="0"/>
        <!-- Deterministic M-Pesa "configured" state, independent of any local .env.
             Tests that need it unconfigured override config() themselves. -->
        <env name="MPESA_ENV" value="sandbox" force="true"/>
        <env name="MPESA_CONSUMER_KEY" value="test-key" force="true"/>
        <env name="MPESA_CONSUMER_SECRET" value="test-secret" force="true"/>
        <env name="MPESA_SHORTCODE" value="174379" force="true"/>
        <env name="MPESA_PASSKEY" value="test-passkey" force="true"/>
        <env name="MPESA_CALLBACK_TOKEN" value="test-callback-token" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
