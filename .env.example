APP_NAME="Serana Closet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Storage stays UTC; customer-facing dates (tracking, receipts) render in this zone.
APP_DISPLAY_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: LOG_STACK=daily (rotates, keeps LOG_DAILY_DAYS=14) and LOG_LEVEL=warning,
# so a busy day can't fill the disk with one ever-growing laravel.log.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Storage disks. Use "s3" for both in production (S3 / Cloudflare R2).
# Always set FILESYSTEM_DISK_PUBLIC explicitly: if unset, the code falls back to "s3".
FILESYSTEM_DISK=local
FILESYSTEM_DISK_PUBLIC=public
# Receipts are queued. Production needs a running `php artisan queue:work`
# (supervisor or cron) and cron for `php artisan schedule:run` every minute
# (M-Pesa reconciliation and stock-hold expiry depend on it).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Production: a brand domain sender with SPF, DKIM and DMARC, or receipts land in spam.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Owner inbox that receives a copy of every paid-order receipt.
# Defaults to MAIL_FROM_ADDRESS when blank.
STORE_NOTIFICATION_EMAIL=

# S3-compatible storage. For Cloudflare R2: region=auto,
# AWS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com, path-style=true,
# AWS_URL=https://<your-public-cdn-domain>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Upload-time image optimization (provider-agnostic; no transform layer needed).
MEDIA_MAX_WIDTH=1600
MEDIA_WEBP_QUALITY=82
MEDIA_IMAGE_DRIVER=gd

VITE_APP_NAME="${APP_NAME}"

# Store WhatsApp number (international format, e.g. 2547XXXXXXXX). The Studio
# setting overrides this when filled in.
WHATSAPP_NUMBER=
# Limited drops stay off until a drop policy is published.
DROPS_ENABLED=false

# PHP / web server upload limits must allow bespoke briefs (up to 6 files x 10MB):
# upload_max_filesize>=10M, post_max_size>=64M, max_file_uploads>=6,
# and the web server body limit (e.g. nginx client_max_body_size 64m).

# M-Pesa Daraja API
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Generate with: php -r "echo bin2hex(random_bytes(24));"
MPESA_CALLBACK_TOKEN=
MPESA_CALLBACK_URL="${APP_URL}/payments/mpesa/callback/${MPESA_CALLBACK_TOKEN}"
# Optional production-only IP allowlist (comma-separated). Leave blank in sandbox.
MPESA_ALLOWED_IPS=

# Proxies allowed to set X-Forwarded-For/-Proto (comma-separated IPs/CIDRs).
# Blank = trust none: right when nginx/PHP faces the internet directly.
# Set it when Cloudflare or a load balancer sits in front (their published
# ranges, or the balancer's private IP); otherwise every visitor looks like the
# proxy's IP and HTTPS terminated there looks like plain HTTP. Never use "*"
# with MPESA_ALLOWED_IPS: anyone could forge the header past the allowlist.
TRUSTED_PROXIES=

# Batch 2 ledger cutover. Leave false until `php artisan serana:ledger:verify`
# reports 0 differences on this server's data, then set true. Setting it back
# to false is the rollback: both sources are kept in step.
LEDGER_READS=false


# Production: HTTPS-only session cookies; local HTTP development may leave unset.
# SESSION_SECURE_COOKIE=true
# MPESA_RESERVATION_MINUTES=15
# MPESA_QUERY_SPACING_SECONDS=13
# MPESA_RECONCILE_BATCH=4
